    "preaudit_committed",
    "spawn_attempted",
    "primitive_invocation_count",
    "primitive_invocation_snapshot",
    "process_audit_envelope",
    "audit_event_sequence",
    "terminal_audit_attempted",
    "terminal_audit_committed"
