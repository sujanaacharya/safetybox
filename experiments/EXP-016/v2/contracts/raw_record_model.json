    "child_completed",
    "capture_status",
    "child_outcome",
    "terminal_class",
    "effect_status",
    "failure_seam",
    "stdout",
    "stderr",
    "marker_observation",
    "timings"
  ],
  "adapter_required_fields": [
    "decision",
    "authorization_subdecisions",
    "exec_validation",
    "cwd_validation",
